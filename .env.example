# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3001

# ─── Database (PostgreSQL) ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=safe_check

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=refresh-change-me-in-production
JWT_REFRESH_EXPIRES_IN=30d

# ─── External APIs ──────────────────────────────────────────────────────────
NEWS_API_KEY=
NEWS_API_URL=
BASE_NAVER_NEWS_URL=https://news.naver.com/breakingnews/section/102/249
BASE_MORE_REQ_URL=https://news.naver.com/section/template/SECTION_ARTICLE_LIST_FOR_LATEST
BASE_NAVER_ARTICLE_URL=https://n.news.naver.com/article

DISASTER_API_KEY=
DISASTER_API_URL=

# ─── Push Notification (Firebase Cloud Messaging) ───────────────────────────
FCM_SERVER_KEY=

# ─── Cache (Redis) ──────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
